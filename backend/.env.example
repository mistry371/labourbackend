NODE_ENV=development
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=labourplatform

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx
RAZORPAY_WEBHOOK_SECRET=xxxx

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Platform
PLATFORM_FEE_PERCENT=15
OTP_EXPIRY_MINUTES=10
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# MSG91 (Email OTP)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_EMAIL_TEMPLATE_ID=your_email_template_id
MSG91_FROM_EMAIL=noreply@servstacks.com
MSG91_FROM_NAME=ServStacks
